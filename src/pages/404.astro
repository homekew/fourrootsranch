---
import CTASection from "../components/CTASection.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <Hero
    compact={true}
    kicker="404"
    title="That trail doesn't lead anywhere yet."
    summary="Some Squarespace URLs may still be in transition. Start from the main sections below and we can get you back on course."
    primaryHref="/"
    primaryLabel="Back to home"
    secondaryHref="/contact"
    secondaryLabel="Contact the sanctuary"
  />

  <CTASection
    title="Looking for something specific?"
    text="Try the animals, donate, news, or FAQ sections first. If the page existed on the old site, it may just need a redirect added during launch."
    primaryHref="/faq"
    primaryLabel="Read the FAQ"
    secondaryHref="/news"
    secondaryLabel="View updates"
  />
</BaseLayout>
