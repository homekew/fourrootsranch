---
import CTASection from "../components/CTASection.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import settings from "../data/site-settings.json";
---

<BaseLayout title="Welcome Home Fund" description="Support the first round of care every new sanctuary resident needs on arrival.">
  <Hero
    compact={true}
    kicker="Targeted giving"
    title="Help cover the first steps of a new resident's arrival."
    summary="The Welcome Home Fund is designed for intake-related onboarding costs like exams, screenings, shearing, and immediate transition care."
    primaryHref={settings.donationLinks.paypal}
    primaryLabel="Give through PayPal or card"
    secondaryHref={settings.donationLinks.venmo}
    secondaryLabel="Give with Venmo"
  />

  <section class="content-page">
    <div class="prose">
      <h2>What early care often includes</h2>
      <ul>
        <li>Veterinary intake exam and farm-call support</li>
        <li>Fecal screening and immediate medication needs</li>
        <li>Shearing, hoof care, or weather-appropriate supplies</li>
        <li>Individual transition support as the animal settles in</li>
      </ul>
      <p>
        These costs can add up quickly, especially when a new resident has gone without routine care. Targeted gifts make those first days gentler and more predictable.
      </p>
      <p><strong>EIN:</strong> {settings.ein}</p>
    </div>

    <aside class="sidebar-card">
      <p class="sidebar-card__eyebrow">Give directly</p>
      <h2>Support the next safe arrival.</h2>
      <div class="donation-stack">
        <a class="button button--primary" href={settings.donationLinks.paypal} target="_blank" rel="noreferrer">
          Donate via PayPal or card
        </a>
        <a class="button button--ghost" href={settings.donationLinks.venmo} target="_blank" rel="noreferrer">
          Donate via Venmo
        </a>
      </div>
    </aside>
  </section>

  <CTASection
    title="Prefer to support everyday care instead?"
    text="General donations still help cover feed, bedding, veterinary needs, and the long-term stability that makes future rescue possible."
    primaryHref="/donate"
    primaryLabel="Visit the main donation page"
  />
</BaseLayout>
