---
import { getEntry } from "astro:content";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import settings from "../data/site-settings.json";

const page = await getEntry("pages", "contact");
if (!page) throw new Error("Missing contact page content.");
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <Hero
    compact={true}
    kicker={page.data.heroKicker}
    title={page.data.title}
    summary={page.data.heroSummary ?? page.data.description}
    primaryHref={page.data.ctaHref}
    primaryLabel={page.data.ctaLabel}
  />

  <section class="content-page">
    <div class="prose">
      <Content />
      <p><strong>Email:</strong> <a href={`mailto:${settings.email}`}>{settings.email}</a></p>
    </div>

    <aside class="sidebar-card" id="contact-form">
      <p class="sidebar-card__eyebrow">General contact</p>
      <h2>Send a message to the ranch.</h2>
      <form action={settings.forms.contact} method="POST" class="site-form">
        <label>
          Your name
          <input type="text" name="name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          What is this about?
          <input type="text" name="subject" required />
        </label>
        <label>
          Message
          <textarea name="message" rows="7" required></textarea>
        </label>
        <button class="button button--primary" type="submit">Send message</button>
      </form>
      <p class="helper-text">This form is wired for a hosted form service. Replace the placeholder endpoint before launch.</p>
    </aside>
  </section>
</BaseLayout>
