---
import { getEntry } from "astro:content";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import settings from "../data/site-settings.json";

const page = await getEntry("pages", "donate");
if (!page) throw new Error("Missing donate page content.");
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <Hero
    compact={true}
    kicker={page.data.heroKicker}
    title={page.data.title}
    summary={page.data.heroSummary ?? page.data.description}
    primaryHref={page.data.ctaHref}
    primaryLabel={page.data.ctaLabel}
    secondaryHref={settings.donationLinks.welcomeHome}
    secondaryLabel="Welcome Home Fund"
  />

  <section class="content-page">
    <div class="prose">
      <Content />
    </div>

    <aside class="sidebar-card" id="donation-options">
      <p class="sidebar-card__eyebrow">Give today</p>
      <h2>Choose the donation path that fits.</h2>
      <div class="donation-stack">
        <a class="button button--primary" href={settings.donationLinks.paypal} target="_blank" rel="noreferrer">
          Donate via PayPal or card
        </a>
        <a class="button button--ghost" href={settings.donationLinks.venmo} target="_blank" rel="noreferrer">
          Donate via Venmo
        </a>
        <a class="button button--ghost" href={settings.donationLinks.welcomeHome}>
          Support the Welcome Home Fund
        </a>
      </div>
      <p class="helper-text">Tax-deductible giving. EIN {settings.ein}.</p>
    </aside>
  </section>
</BaseLayout>
