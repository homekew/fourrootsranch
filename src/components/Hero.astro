---
interface Props {
  kicker?: string;
  title: string;
  summary: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  compact?: boolean;
}

const {
  kicker,
  title,
  summary,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  compact = false
} = Astro.props;
---

<section class:list={["hero", compact && "hero--compact"]}>
  <div class="hero__copy">
    {kicker && <p class="hero__kicker">{kicker}</p>}
    <h1>{title}</h1>
    <p class="hero__summary">{summary}</p>
    {(primaryHref || secondaryHref) && (
      <div class="hero__actions">
        {primaryHref && primaryLabel && (
          <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>
        )}
        {secondaryHref && secondaryLabel && (
          <a class="button button--ghost" href={secondaryHref}>{secondaryLabel}</a>
        )}
      </div>
    )}
  </div>

  <div class="hero__panel" aria-hidden="true">
    <div class="hero__ring hero__ring--one"></div>
    <div class="hero__ring hero__ring--two"></div>
    <div class="hero__card">
      <span>110+</span>
      <p>Animals receiving lifelong, individualized care in Bend, Oregon.</p>
    </div>
  </div>
</section>
