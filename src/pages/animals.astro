---
import AnimalCard from "../components/AnimalCard.astro";
import CTASection from "../components/CTASection.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import animals from "../data/animals.json";
---

<BaseLayout title="Animals" description="Meet the resident groups who make Four Roots Ranch a home and a sanctuary.">
  <Hero
    compact={true}
    kicker="Meet the residents"
    title="A sanctuary built around the needs of animals who deserve to exhale."
    summary="This page is structured for future resident spotlights, but today it introduces the major animal groups who shape life at the ranch."
    primaryHref="/donate"
    primaryLabel="Support resident care"
  />

  <section class="stack-section">
    <div class="card-grid">
      {animals.entries.map((animal) => (
        <AnimalCard {...animal} />
      ))}
    </div>
  </section>

  <CTASection
    title="Want to follow the animals more closely?"
    text="The ranch shares more day-to-day resident stories through Instagram and Substack while the full media archive is migrated out of Squarespace."
    primaryHref="https://www.instagram.com/fourrootsranch/"
    primaryLabel="Follow on Instagram"
    secondaryHref="https://fourrootsranchsanctuary.substack.com/"
    secondaryLabel="Read on Substack"
  />
</BaseLayout>
