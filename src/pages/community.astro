---
import { getEntry } from "astro:content";
import CTASection from "../components/CTASection.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "community");
if (!page) throw new Error("Missing community page content.");
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <Hero
    compact={true}
    kicker={page.data.heroKicker}
    title={page.data.title}
    summary={page.data.heroSummary ?? page.data.description}
    primaryHref={page.data.ctaHref}
    primaryLabel={page.data.ctaLabel}
  />

  <section class="prose prose--wide">
    <Content />
  </section>

  <CTASection
    title="Need practical help with animals in your care?"
    text="The rebuilt site makes the sanctuary's support areas easier to find while keeping high-touch requests routed through the right contact points."
    primaryHref="/contact"
    primaryLabel="Contact the sanctuary"
    secondaryHref="/faq"
    secondaryLabel="Read the FAQ"
  />
</BaseLayout>
