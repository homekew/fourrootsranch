---
import { getEntry } from "astro:content";
import CTASection from "../components/CTASection.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import settings from "../data/site-settings.json";

const page = await getEntry("pages", "art");
if (!page) throw new Error("Missing art page content.");
const { Content } = await page.render();
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <Hero
    compact={true}
    kicker={page.data.heroKicker}
    title={page.data.title}
    summary={page.data.heroSummary ?? page.data.description}
    primaryHref={page.data.ctaHref}
    primaryLabel={page.data.ctaLabel}
  />

  <section class="prose prose--wide">
    <Content />
  </section>

  <CTASection
    title="Ready to move products off Squarespace?"
    text="This page is positioned to support an external storefront while keeping the storytelling and mission on the main site."
    primaryHref={settings.shopUrl}
    primaryLabel="Open the shop"
    secondaryHref="/shop"
    secondaryLabel="See storefront details"
  />
</BaseLayout>
